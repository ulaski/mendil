# Copy to .env and adjust. Only TS3CLIENT_LICENSE and TS3_HOST are required.

# --- License --------------------------------------------------------------------
# The official TeamSpeak 3 client is downloaded on first start. By setting this to
# "accept" you accept its license: https://www.teamspeak.com/en/privacy-and-terms/
# Voice engine: "classic" (the official TeamSpeak client, default) or "native"
# (experimental, no TeamSpeak client; also runs on ARM). See README "How it works".
VOICE_BACKEND=classic
# Native engine only: Opus bitrate in kbit/s (48-192)
NATIVE_BITRATE=128

TS3CLIENT_LICENSE=

# --- TeamSpeak server -------------------------------------------------------
# Server address: host name, IP or host:port
TS3_HOST=ts.example.com
TS3_PORT=9987
TS3_SERVER_PASSWORD=

# Channel to join (name or path like "Games/Music"); empty = default channel
TS3_CHANNEL=
TS3_CHANNEL_PASSWORD=

BOT_NICKNAME=Mendil

# --- Bot ----------------------------------------------------------------------
# Chat language: en, tr
BOT_LANGUAGE=en
COMMAND_PREFIX=!
# Who may control the bot (type !whoami in TeamSpeak to see your ID and groups).
# Comma-separated unique IDs and/or server group IDs; both empty = everyone
ALLOWED_UIDS=
ALLOWED_GROUPS=
# Post a hint when the channel's codec or talk power is wrong for music
CHANNEL_HINTS=true
# Post "Now playing" messages to the channel
ANNOUNCE_TRACKS=true

# --- Audio / queue ------------------------------------------------------------
# Start-up volume, 0-100
DEFAULT_VOLUME=70
# Loudness-normalise tracks so they all play at a similar volume
NORMALIZE_AUDIO=true
MAX_QUEUE=100
MAX_PLAYLIST_ITEMS=50
# Max track length in seconds, live streams included; 0 = unlimited
MAX_TRACK_DURATION=0
# Download tracks before playing them (no gaps); longer tracks and live streams are streamed
PREFETCH=true
PREFETCH_MAX_DURATION=1800

# --- yt-dlp -----------------------------------------------------------------
# Keep yt-dlp updated in the background (YouTube changes often)
YTDLP_AUTO_UPDATE=true
# If YouTube blocks this server ("confirm you're not a bot"), see docs/youtube.md.
# Netscape-format cookies file (mounted writable)
YTDLP_COOKIES_FILE=
# Proxy for yt-dlp only, e.g. socks5://user:pass@host:1080
YTDLP_PROXY=
# Let !play open addresses on private networks (LAN, localhost). See SECURITY.md.
ALLOW_PRIVATE_URLS=false

# --- Web panel -----------------------------------------------------------------
# Port inside the container (publish it in docker-compose.yml); 0 = off
PANEL_PORT=8080
# Empty = generated on first start and printed in the log
PANEL_PASSWORD=
# true when a reverse proxy (Caddy, nginx…) sits in front of the panel
PANEL_TRUST_PROXY=false

# debug | info | warn | error
LOG_LEVEL=info

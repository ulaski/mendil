# --- TeamSpeak server -------------------------------------------------------
# Address of your TS3 server (host or host:port)
TS3_HOST=ts.example.com
TS3_PORT=9987
TS3_SERVER_PASSWORD=

# Channel the bot joins on connect (name or path like "Oyun/Müzik"); empty = default channel
TS3_CHANNEL=
TS3_CHANNEL_PASSWORD=

BOT_NICKNAME=MusicBot

# --- Bot ----------------------------------------------------------------------
COMMAND_PREFIX=!
# Comma-separated TS3 unique IDs allowed to use the bot; empty = everyone
ALLOWED_UIDS=
# Post "▶ Now playing" messages to the channel
ANNOUNCE_TRACKS=true

# --- Audio / queue ------------------------------------------------------------
DEFAULT_VOLUME=70
# Loudness-normalise tracks so volume is consistent between songs
NORMALIZE_AUDIO=true
MAX_QUEUE=100
MAX_PLAYLIST_ITEMS=50
# Max track length in seconds; 0 = unlimited
MAX_TRACK_DURATION=0

# --- yt-dlp -----------------------------------------------------------------
YTDLP_AUTO_UPDATE=true
# Netscape-format cookies file if YouTube asks to "confirm you're not a bot"
YTDLP_COOKIES_FILE=

LOG_LEVEL=info
